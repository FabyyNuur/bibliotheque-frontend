{
  "extends": [
    "development"
  ],
  "hints": {
    "axe/forms": [
      "default",
      {
        "label": "off",
        "select-name": "off"
      }
    ],
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "position: sticky",
          "-webkit-text-size-adjust",
          "user-select"
        ]
      }
    ],
    "axe/name-role-value": [
      "default",
      {
        "button-name": "off"
      }
    ],
    "axe/aria": [
      "default",
      {
        "aria-required-attr": "off",
        "aria-input-field-name": "off",
        "aria-valid-attr-value": "off",
        "aria-required-children": "off"
      }
    ]
  }
}